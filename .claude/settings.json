{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/sync-skills.sh\" >/dev/null 2>&1 || true",
            "statusMessage": "Syncing project skills to ~/.claude/skills"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/log-skill-use.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
